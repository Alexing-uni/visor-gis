{
  "name": "visor-gis",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.mjs",
    "data:catalog": "node scripts/update-places.mjs",
    "dev:static": "vite --host 127.0.0.1 --mode static",
    "build:pages": "tsc -b && vite build --mode static",
    "preview": "vite preview --host 127.0.0.1",
    "check:routing": "node scripts/check-routing-live.mjs"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@deck.gl/core": "^9.2.0",
    "@deck.gl/geo-layers": "^9.2.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.2.0",
    "@turf/bbox": "^7.2.0",
    "@turf/turf": "^7.4.0",
    "antd": "^5.27.0",
    "express": "^5.1.0",
    "maplibre-gl": "^6.11.2",
    "proj4": "^2.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
